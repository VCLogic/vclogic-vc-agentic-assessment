      "attributed_source_line_sha256": "b23f79b07e06d137d17c786d4d0ebbff0e2020fd0268cd3a91bafa1047485130",
      "preceded_by_investor_decision": false,
      "reason": "removed non-founder, evaluative, or unnecessary context",
      "rendered_text": "",
