      "attributed_source_line_sha256": "66f2b868e1c538656f133c856b418265ead4f01cbdad00cbd51e81460dabaaa6",
      "preceded_by_investor_decision": false,
      "reason": "neutralized investor question",
      "rendered_text": "Investor question: You're telling me a big chain is signing you up?",
      "retained_content_class": "explicit_investor_question",
      "source_turn_index": 22,
      "speaker": "Michael",
      "unattributed_continuation_count": 0
    },
    {
      "action": "retained",
      "attributed_source_line_index": 0,
      "attributed_source_line_sha256": "979ee45e5a6bdf9d167386218137d3b895ec8ead942e47c43ea958d38ac7379d",
      "preceded_by_investor_decision": false,
      "reason": "founder pitch or pre-decision factual answer",
      "rendered_text": "Cody: We actually had Kmart reach out to us and say, hey, we're interested.",
      "retained_content_class": "explicit_founder",
      "source_turn_index": 23,
      "speaker": "Cody",
      "unattributed_continuation_count": 0
    },
    {
      "action": "removed",
