      "attributed_source_line_sha256": "51caedcaef38c3f444db7a419b0974dda35452a539b856e100527d7a8f3702cb",
      "preceded_by_investor_decision": false,
      "reason": "removed non-founder, evaluative, or unnecessary context",
      "rendered_text": "",
